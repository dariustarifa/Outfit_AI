{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": {
        "$value": "#F5F2EB",
        "$description": "Warm ivory used at the top of Outfit's vertical background."
      },
      "foreground": { "$value": "#2B2B2E" },
      "border": {
        "$value": "#DDD3C7",
        "$description": "Warm neutral border; the glass treatment uses its own translucent white edge."
      },
      "card": { "$value": "#F5F2EB" },
      "cardForeground": { "$value": "#2B2B2E" },
      "popover": { "$value": "#F5F2EB" },
      "popoverForeground": { "$value": "#2B2B2E" },
      "primary": {
        "$value": "#2B2B2E",
        "$description": "Charcoal ink for primary actions and emphasis."
      },
      "primaryForeground": { "$value": "#F5F2EB" },
      "secondary": {
        "$value": "#DDD3C7",
        "$description": "Warm taupe from the lower end of the app background gradient."
      },
      "secondaryForeground": { "$value": "#2B2B2E" },
      "muted": { "$value": "#E6D2B8" },
      "mutedForeground": { "$value": "#6B665F" },
      "accent": {
        "$value": "#D8BC8C",
        "$description": "Soft gold used for quiet accent surfaces; darker gold details use chart1."
      },
      "accentForeground": { "$value": "#2B2B2E" },
      "destructive": {
        "$value": "#A33A3A",
        "$description": "Muted brick red for destructive actions and validation errors."
      },
      "destructiveForeground": { "$value": "#F5F2EB" },
      "input": { "$value": "#DDD3C7" },
      "ring": { "$value": "#9A7B4F" },
      "chart1": {
        "$value": "#9A7B4F",
        "$description": "Outfit's muted antique-gold detail color."
      },
      "chart2": { "$value": "#C9D3C1" },
      "chart3": { "$value": "#E6D2B8" },
      "chart4": { "$value": "#D8BC8C" },
      "chart5": { "$value": "#6B665F" },
      "sidebar": { "$value": "#F5F2EB" },
      "sidebarForeground": { "$value": "#2B2B2E" },
      "sidebarBorder": { "$value": "#DDD3C7" },
      "sidebarPrimary": { "$value": "#2B2B2E" },
      "sidebarPrimaryForeground": { "$value": "#F5F2EB" },
      "sidebarAccent": { "$value": "#E6D2B8" },
      "sidebarAccentForeground": { "$value": "#2B2B2E" },
      "sidebarRing": { "$value": "#9A7B4F" }
    },
    "dark": {
      "background": { "$value": "#2B2B2E" },
      "foreground": { "$value": "#F5F2EB" },
      "border": { "$value": "#6B665F" },
      "card": { "$value": "#6B665F" },
      "cardForeground": { "$value": "#F5F2EB" },
      "popover": { "$value": "#6B665F" },
      "popoverForeground": { "$value": "#F5F2EB" },
      "primary": { "$value": "#F5F2EB" },
      "primaryForeground": { "$value": "#2B2B2E" },
      "secondary": { "$value": "#6B665F" },
      "secondaryForeground": { "$value": "#F5F2EB" },
      "muted": { "$value": "#6B665F" },
      "mutedForeground": { "$value": "#DDD3C7" },
      "accent": { "$value": "#D8BC8C" },
      "accentForeground": { "$value": "#2B2B2E" },
      "destructive": {
        "$value": "#E07B7B",
        "$description": "Accessible soft brick red for destructive actions and validation errors on dark surfaces."
      },
      "destructiveForeground": { "$value": "#F5F2EB" },
      "input": { "$value": "#6B665F" },
      "ring": { "$value": "#D8BC8C" },
      "chart1": { "$value": "#D8BC8C" },
      "chart2": { "$value": "#C9D3C1" },
      "chart3": { "$value": "#E6D2B8" },
      "chart4": { "$value": "#DDD3C7" },
      "chart5": { "$value": "#9A7B4F" },
      "sidebar": { "$value": "#2B2B2E" },
      "sidebarForeground": { "$value": "#F5F2EB" },
      "sidebarBorder": { "$value": "#6B665F" },
      "sidebarPrimary": { "$value": "#D8BC8C" },
      "sidebarPrimaryForeground": { "$value": "#2B2B2E" },
      "sidebarAccent": { "$value": "#6B665F" },
      "sidebarAccentForeground": { "$value": "#F5F2EB" },
      "sidebarRing": { "$value": "#D8BC8C" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Satoshi", "sans-serif"],
        "$description": "Use Satoshi for all interface and body text."
      },
      "serif": {
        "$value": ["Melodrama", "serif"],
        "$description": "Reserve Melodrama Medium for large editorial headlines."
      },
      "mono": { "$value": ["Satoshi", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "1.5rem",
      "$description": "24px base card radius; pill controls use fully rounded corners."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
